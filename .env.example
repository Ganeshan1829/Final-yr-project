PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Python interpreter for the OR-Tools solver (setup.sh sets this to the project's .venv)
# PYTHON_BIN=python3
# Port of the optional ML service
# ML_PORT=8000

# Chatbot LLM: "mock" (offline, default) or "openrouter" (any OpenAI-compatible API)
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/free
# LLM_API_KEY=your-openrouter-key
# LLM_BASE_URL=https://openrouter.ai/api/v1
